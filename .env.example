# ---------------------------------------------------------------------------
# Lift-Off environment
# Copy to .env and adjust. All values are optional in development.
# ---------------------------------------------------------------------------

# Port the API/UI server listens on.
PORT=4000

# Where Lift-Off keeps its database, deploy keys, and cloned repos.
# LIFTOFF_DATA_DIR=/var/lib/liftoff

# 32-byte key used to encrypt secrets at rest (SSH deploy keys, personal access
# tokens, and the SMTP password). 64 hex chars, or base64. If unset, a key file
# is generated in the data dir.
# LIFTOFF_SECRET_KEY=

# Admin password for the web UI. If unset, a random one is generated and
# printed to the console on first boot. Set this in production.
# LIFTOFF_ADMIN_PASSWORD=

# Username for the owner account created on first boot. Defaults to "admin".
# LIFTOFF_ADMIN_USERNAME=admin

# Set to true once the UI is served over HTTPS, so the session cookie is
# marked Secure. Leave false on plain HTTP or login will fail.
# LIFTOFF_COOKIE_SECURE=false

# How many builds may run at once.
# LIFTOFF_MAX_CONCURRENT_BUILDS=1

# Location of the built UI, when running from source in production.
# LIFTOFF_WEB_DIST=./web/dist

# Set by pm2 / systemd in production.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Not environment variables: SMTP for password-reset email is configured in the
# UI, under Settings -> Email delivery, by an admin account.
# ---------------------------------------------------------------------------
